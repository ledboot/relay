ADMIN_TOKEN=replace-with-a-random-token-at-least-24-characters
TEXTVERIFIED_API_KEY=replace-with-your-textverified-api-key
TEXTVERIFIED_API_USERNAME=
TEXTVERIFIED_WEBHOOK_SECRET=
TEXTVERIFIED_BASE_URL=https://www.textverified.com
TEXTVERIFIED_MAX_PRICE=5
# 接码超时（未收到验证码）后允许为该 CD Key 重新购买号码的次数；0 表示关闭重试
MAX_RETRIES=1
DATABASE_PATH=./sms.db
LISTEN_ADDR=127.0.0.1:8080
API_INTERNAL_URL=http://127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# 限流：/api/redeem 与 /api/status 按 CD Key 分桶；其余请求按客户端身份分桶
KEY_RATE_LIMIT_PER_MIN=120
RATE_LIMIT_PER_MIN=120

ADMIN_PATH=/console

# Backend logging: text/json; DEBUG/INFO/WARN/ERROR
LOG_FORMAT=text
LOG_LEVEL=INFO
